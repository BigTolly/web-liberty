{
  "manifest_version": 3,
  "name": "Web Liberty",
  "version": "1.0.0",
  "description": "Manage multiple SOCKS4/5, HTTP/HTTPS proxies with quick switching and domain whitelist/blacklist support.",
  "permissions": ["proxy", "storage", "webRequest", "webRequestBlocking"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "web-liberty@bigtolly",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Liberty",
    "default_icon": {
      "16": "icons/off16.png",
      "32": "icons/off32.png",
      "48": "icons/off48.png",
      "128": "icons/off128.png"
    }
  },
  "icons": {
    "16": "icons/on16.png",
    "32": "icons/on32.png",
    "48": "icons/on48.png",
    "128": "icons/on128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
